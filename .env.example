# ---------------------------------------------------------------------------
# Discord Live Dashboard - configuration
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# On a host (Render/Railway/Fly) set these in the service's Environment tab
# instead of using a .env file.
# ---------------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> your app ->
# Bot tab -> "Reset Token" -> Copy.  NEVER commit the real token anywhere.
DISCORD_BOT_TOKEN=

# HTTP port (default 3000).  On Render/Railway/Fly LEAVE THIS UNSET - the
# platform injects PORT itself and routes traffic to it. Hard-coding a value
# there breaks the port binding and the health check.
# PORT=3000

# Force the built-in simulator instead of connecting to Discord.
# Useful for demoing the live pipeline without a token: DEMO_MODE=1
DEMO_MODE=0

# Optional. Comma-separated guild (server) IDs to monitor.
# Leave empty to monitor every server the bot has joined.
GUILD_IDS=

# How many messages to pull per channel when opening a chat view (1-100).
HISTORY_LIMIT=100

# How many messages to keep in memory per channel for the live view.
MAX_MESSAGES_PER_CHANNEL=200

# Verbose gateway/REST logging ("1" to enable). Handy when diagnosing a
# connection problem from the host's log viewer.
DEBUG=0

# Optional User-Agent override. Discord expects `DiscordBot (<url>, <version>)`.
# DISCORD_UA=DiscordBot (https://example.com, 1.0.0)

# How often to refresh guild member counts over REST (ms). Default 60000.
# COUNT_REFRESH_MS=60000

# How long to wait before retrying after a fatal gateway error (ms).
# Default 300000 (5 minutes).
# FATAL_RETRY_MS=300000
